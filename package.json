{
  "name": "gestor-de-variables",
  "version": "2.0.0",
  "description": "Gestor de Variables – SESNA (backend Node.js/Express + Supabase)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "debug": "node --inspect --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "adm-zip": "^0.6.1",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
