# ===== Supabase (credenciales) =====
SUPABASE_URL=
# Llave publicable (anon). Solo respaldo; el servidor usa la service_role.
SUPABASE_KEY=
# Llave service_role: SOLO backend, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Conexion Postgres directa (solo para `npm run db:setup`)
DATABASE_URL=

# ===== Aplicacion =====
PORT=8000
# Modo debug: logs detallados, trazas en respuestas de error, plantilla sin cache
DEBUG=false
NODE_ENV=production
# true = sin login (solo desarrollo)
DISABLE_AUTH=false
# OBLIGATORIO en produccion (min. 32 caracteres): fija la sesion entre reinicios
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Opcional: tunel publico
# NGROK_AUTH_TOKEN=

# ===== Base de datos =====
# Opcional: token personal "sbp_..." para `npm run db:setup` via Management API (HTTPS)
SUPABASE_ACCESS_TOKEN=

# ===== Produccion =====
HOST=0.0.0.0
# Poner en true cuando se sirva por HTTPS (cookie Secure + HSTS). Con HTTP plano el login no funcionaria.
COOKIE_SECURE=false
# Saltos de proxy inverso (ej. 1 con nginx). Vacio = sin proxy
TRUST_PROXY=
# Contrasena inicial del admin si la tabla usuarios esta vacia (obligatoria en produccion en el primer arranque)
ADMIN_PASSWORD=
